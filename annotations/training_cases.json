  "decision_order": [
    "candidate",
    "occurrence",
    "members",
    "gaps",
    "category"
  ],
  "disagreement_codes": [
    {
      "code": "literal_or_spatial_promoted",
      "level": "occurrence",
      "definition": "A literal, compositional, or spatial use was confirmed as an in-scope occurrence."
    },
    {
      "code": "accidental_sequence_promoted",
      "level": "occurrence",
      "definition": "Adjacent or nearby forms without the required verbal construction were confirmed."
    },
    {
      "code": "inflected_member_missed",
      "level": "span",
      "definition": "An eligible inflected surface member was omitted because it did not match the citation form."
    },
    {
      "code": "particle_movement_missed",
      "level": "span",
      "definition": "A moved particle was omitted or attached to the wrong candidate."
    },
    {
      "code": "open_slot_marked_member",
      "level": "span",
      "definition": "A replaceable pronoun, noun phrase, determiner, possessor, modifier, or other open slot was marked as lexicalized."
    },
    {
      "code": "required_member_omitted",
      "level": "span",
      "definition": "A lexicalized particle or fixed dependent required by the occurrence was omitted."
    },
    {
      "code": "gap_not_complete",
      "level": "span",
      "definition": "The gap does not contain every nonmember token strictly between the first and last member."
    },
    {
      "code": "tokenization_mismatch",
      "level": "span",
      "definition": "The records rely on different token boundaries or an annotator retokenized the frozen input."
    },
    {
      "code": "embedded_occurrence_omitted",
      "level": "span",
      "definition": "An independently qualifying embedded or overlapping occurrence was not recorded."
    },
    {
      "code": "particle_preposition_boundary",
      "level": "category",
      "definition": "The same exact span was analyzed as particle-like versus prepositional or spatial."
    },
    {
      "code": "vpc_full_semi_boundary",
      "level": "category",
      "definition": "The same exact particle construction received VPC.full versus VPC.semi."
    },
    {
      "code": "vpc_vid_boundary",
      "level": "category",
      "definition": "The same exact lexicalized components received a VPC versus VID analysis."
    },
    {
      "code": "unclassified",
      "level": "fallback",
      "definition": "The first recoverable source of disagreement cannot be determined from the retained raw records."
    }
  ],
  "tokenization_rules": [
    "Use the frozen preprocessing token IDs; do not retokenize during annotation.",
    "Internal straight or curly apostrophes remain inside one token.",
    "ASCII hyphens split token records, but orthographic splitting alone does not create MWE membership.",
    "Punctuation without a token ID is neither a member nor a gap token."
  ],
